# See https://wiki.hyprland.org/Configuring/Monitors/
# monitor = HDMI-A-1, 1024x600@60, 0x-1080, 1
# monitor = HDMI-A-1, auto
#monitor = HDMI-A-1,3840x2160@60,0x1080,1
#monitor = HDMI-A-1, 1920x1080@60, 0x-1080, 1

# monitor = DP-3, 1920x1080@60, 1920x-1080, 1
# monitor = DP-4, 1920x1080@60, 0x-1080, 1

# Internal Laptop Screen
# monitor = desc:BOE 0x091B, 1920x1080@60, 0x1080, 1
monitor = desc:BOE 0x091B, 1920x1080@60, 0x0, 1

## Set up 1 - with internal
# External Monitor 1 (HP 24fw) - Placed to the right of laptop
monitor = desc:HP Inc. HP 24fw 3CM0011DQD, 1920x1080@60, 0x-1080, 1
# # External Monitor 2 (HP M24f) - Placed to the right of Monitor 1
monitor = desc:HP Inc. HP M24f FHD 3CM1321BNL, 1920x1080@60, -1920x-1080, 1
#

## Set up two - with internal
# monitor = desc:HP Inc. HP 24fw 3CM0371MB4, 1920x1080@60, 0x0, 1
# monitor = desc:HP Inc. HP 24fw 3CM9480NYW, 1920x1080@60, 1920x0, 1
#


### workspace config 
# Binding workspace to monitors
workspace = 1, monitor:eDP-1, default:true
workspace = 2, monitor:eDP-1
workspace = 3, monitor:eDP-1
workspace = 4, monitor:eDP-1
workspace = 5, monitor:eDP-1
workspace = 6, monitor:eDP-1
workspace = 7, monitor:eDP-1
workspace = 8, monitor:eDP-1
workspace = 9, monitor:eDP-1
workspace = 10, monitor:eDP-1

# Add these workspace definitions for DP-4 (after your other workspace definitions)
workspace = 11, monitor:DP-4, default:true
workspace = 12, monitor:DP-4
workspace = 13, monitor:DP-4
workspace = 14, monitor:DP-4
workspace = 15, monitor:DP-4
workspace = 16, monitor:DP-4
workspace = 17, monitor:DP-4
workspace = 18, monitor:DP-4
workspace = 19, monitor:DP-4
workspace = 20, monitor:DP-4

workspace = 101, monitor:DP-3, default:true
workspace = 102, monitor:DP-3
workspace = 103, monitor:DP-3
workspace = 104, monitor:DP-3
workspace = 105, monitor:DP-3
workspace = 106, monitor:DP-3
workspace = 107, monitor:DP-3
workspace = 108, monitor:DP-3
workspace = 109, monitor:DP-3
workspace = 110, monitor:DP-3
